{
  "name": "studio-admin",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:firecrawl": "node --conditions=react-server --import tsx --test src/lib/firecrawl/__tests__/*.test.ts",
    "test:goal-engine": "node --conditions=react-server --import tsx --test src/lib/goal-engine/__tests__/*.test.ts",
    "test:equity-lifecycle": "node --conditions=react-server --import tsx --test src/domain/equityLifecycle/__tests__/*.test.ts",
    "test:slice-engine": "node --conditions=react-server --import tsx --test src/domain/sliceCalculation/__tests__/*.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test:signal-engine": "node --conditions=react-server --import tsx --test src/lib/signal-engine/__tests__/*.test.ts",
    "test:identity": "node --import tsx --test src/lib/identity/__tests__/*.test.ts",
    "test:application-agent": "node --conditions=react-server --import tsx --test src/lib/application-agent/__tests__/*.test.ts",
    "test:accelerators": "node --import tsx --test src/lib/accelerators/__tests__/*.test.ts",
    "test:gemini": "node --conditions=react-server --import tsx --test src/lib/gemini/__tests__/*.test.ts",
    "test:p0-readiness": "node --conditions=react-server --import tsx --test src/lib/application-questions/__tests__/*.test.ts src/lib/configuration/__tests__/*.test.ts src/lib/knowledge/__tests__/*.test.ts",
    "test:supabase-rls": "node scripts/verify-supabase-rls.mjs",
    "verify:production-schema": "node scripts/verify-production-schema.mjs",
    "prepare": "husky",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.24.0",
    "@skyvern/client": "^1.0.24",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "decimal.js": "^10.6.0",
    "firecrawl": "4.41.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
